# Everything is optional. With the `claude` CLI installed and signed in, recipe
# suggestions run on your existing Claude subscription and need no key at all.

# Where the database and config live (default ~/.sous-chef)
# SOUS_CHEF_DIR=~/.sous-chef
# SOUS_CHEF_DB_PATH=~/.sous-chef/sous-chef.db

# Model the recipe chef runs on: an alias the `claude` CLI understands
# SOUS_CHEF_MODEL=sonnet
